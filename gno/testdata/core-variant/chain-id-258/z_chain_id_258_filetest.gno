// PKGPATH: gno.land/r/wormhole_test/variant
package variant

// The test runner runs this under a Core test configuration whose
// Wormhole chain ID is 258, 0x0102 (run chain-id-258): unlike the corpus's
// 65535, its two bytes differ. SubmitGovernance compares an upgrade's target
// with the configured chain ID, so an upgrade aimed at 65535 or at chain 2
// is another chain's, and one aimed at every chain still applies. The VAAs
// are the upgrades from set 3 of corpus scenarios upgrade-target-this-chain,
// upgrade-target-other-chain and upgrade-target-all-chains of the Core test
// corpus (gno/testdata/core-vectors.json).

import (
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/core"
)

const (
	aimedAt65535 = ""
	aimedAt2     = ""
	aimedAtAll   = ""
)

func main(cur realm) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(1800000000, 0)
	testing.SetContext(ctx)
	submit := func(wire string) {
		raw, err := hex.DecodeString(wire)
		if err != nil {
			panic(err)
		}
		r := revive(func() {
			core.SubmitGovernance(cross(cur), raw)
		})
		if r == nil {
			println("accept", core.CurrentGuardianSetIndex())
		} else {
			println("reject", r, core.CurrentGuardianSetIndex())
		}
	}
	println(core.ChainID())
	submit(aimedAt65535)
	submit(aimedAt2)
	submit(aimedAtAll)
}

// Output:
// 258
// reject core: governance-wrong-target-chain 3
// reject core: governance-wrong-target-chain 3
// accept 4
