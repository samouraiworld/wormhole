// PKGPATH: gno.land/r/wormhole_test/variant
package variant

// The test runner runs this under a Core test configuration whose
// replayUntilIndex is 5, two above the initial set (run replay-until-5), as
// for a deployment that replays two earlier guardian-set upgrades. Every set
// replaced while the current index is below replayUntilIndex is flagged
// expired at once, so VAAs from sets 3 and 4 are both refused right after the
// second upgrade. Both upgrades consume their digest and emit their event,
// as on the fresh path. The VAAs are steps 0, 1, 2 and 4 of corpus scenario
// double-rotation (gno/testdata/core-vectors.json).

import (
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/core"
)

const (
	upgrade3to4 = ""
	upgrade4to5 = ""
	verifySet3  = ""
	verifySet4  = ""
)

func main(cur realm) {
	step := func(op string, at int64, wire string) {
		ctx := testing.GetContext()
		ctx.Time = time.Unix(at, 0)
		testing.SetContext(ctx)
		raw, err := hex.DecodeString(wire)
		if err != nil {
			panic(err)
		}
		var digest [32]byte
		if op == "governance" {
			digest = core.VerifyVAA(raw).Digest
		}
		r := revive(func() {
			if op == "verify" {
				core.VerifyVAA(raw)
			} else {
				core.SubmitGovernance(cross(cur), raw)
			}
		})
		if r == nil {
			println("accept", core.CurrentGuardianSetIndex())
		} else {
			println("reject", r, core.CurrentGuardianSetIndex())
		}
		if op == "governance" {
			println("consumed", core.GovernanceConsumed(digest))
		}
	}
	show := func(index uint32) {
		_, expiration, expired, _ := core.GuardianSet(index)
		println("set", index, expiration, expired)
	}
	step("governance", 1800000000, upgrade3to4)
	step("governance", 1800003600, upgrade4to5)
	show(3)
	show(4)
	step("verify", 1800003600, verifySet3)
	step("verify", 1800003600, verifySet4)
}

// Output:
// accept 4
// consumed true
// accept 5
// consumed true
// set 3 0 true
// set 4 0 true
// reject core: guardian-set-expired 5
// reject core: guardian-set-expired 5

