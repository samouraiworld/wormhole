// PKGPATH: gno.land/r/wormhole_test/delayedclaim
package delayedclaim

// Completing a delayed claim. One second before its release
// CompleteClaim fails with claim-not-released. At its release a relayer completes
// it under the relayer-fee rule, with no count in the window, then or at its
// release. A second completion fails with claim-completed, also through a new
// logic after a switch. A claim recorded before its asset became exit-only
// completes at its time through the new logic, which applies neither the
// allowlist nor the limits, and its recipient owes no fee. The logic's other
// refusals are the vault's: a wrong body, a payload-3 claim and a transfer with
// no claim. Under a pause, the gate comes first.

import (
	"chain"
	"chain/banker"
	"encoding/hex"
	"testing"
	"time"

	tb "gno.land/p/wormhole/tokenbridge/v0"
	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
	v2 "gno.land/r/wormhole/tokenbridge/logic/v2"
)

const (
	start     = 1_800_000_000
	peer      = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
	usdc      = "000000000000000000000000a000000000000000000000000000000000000048"
	bodyStart = 6 + 66*13
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[bodyStart+42 : bodyStart+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

func at(unix int64) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(unix, 0)
	testing.SetContext(ctx)
}

// as makes who the caller of main's next crossing call, under an origin caller
// that is not who, so that only cur.Previous() can name the redeemer.
func as(who address) {
	ctx := testing.GetContext()
	ctx.CurrentRealm = testing.NewUserRealm(who)
	ctx.OriginCaller = chain.PackageAddress("gno.land/r/wormhole_test/origin")
	testing.SetContext(ctx)
}

func ugnot(a address) int64 {
	return banker.NewReadonlyBanker().GetCoin(a, "ugnot")
}

func main(cur realm) {
	at(start)
	user := chain.PackageAddress("gno.land/r/wormhole_test/user")
	relayer := chain.PackageAddress("gno.land/r/wormhole_test/relayer")
	token := tb.GNOTAddress()
	gnot := hex.EncodeToString(token[:])
	var emitter [32]byte
	copy(emitter[:], wire(peer))
	tokenbridge.RegisterChain(cross(cur), wire(""))
	tokenbridge.SetPauserAddresses(cross(cur), wire(""))
	v1.CreateWrapped(cross(cur), wire(""))
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole/tokenbridge/logic/v1"))
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge"),
		chain.NewCoins(chain.NewCoin("ugnot", 5000)))
	tokenbridge.LockAndPublish(cross(cur), user, 5000, 2, [32]byte{31: 0xee}, 0, 0)
	as(relayer)

	// A GNOT claim over a budget already counted, and a USDC claim over budget
	// by itself, the first with a relayer fee of 10 and the second 20.
	v1.Redeem(cross(cur), wire(""))
	gnotClaim := wire("")
	seq := sequence(gnotClaim)
	v1.Redeem(cross(cur), gnotClaim)
	body := gnotClaim[bodyStart:]
	usdcClaim := wire("")
	v1.Redeem(cross(cur), usdcClaim)
	payload3 := wire("")
	v1.Redeem(cross(cur), payload3)
	println(ugnot(user), ugnot(relayer), tokenbridge.LockedGNOT())

	at(start + 86399)
	println(revive(func() { v1.CompleteClaim(cross(cur), 2, emitter, seq, body) }))
	println(ugnot(user), ugnot(relayer), tokenbridge.LockedGNOT())

	at(start + 86400)
	println(revive(func() { v1.CompleteClaim(cross(cur), 2, emitter, seq, body[:len(body)-1]) }))
	println(revive(func() { v1.CompleteClaim(cross(cur), 2, emitter, seq+1000, body) }))
	println(revive(func() { v1.CompleteClaim(cross(cur), 2, emitter, sequence(payload3), payload3[bodyStart:]) }))
	v1.CompleteClaim(cross(cur), 2, emitter, seq, body)
	println(ugnot(user), ugnot(relayer), tokenbridge.LockedGNOT())
	println(v1.Limits(65535, gnot))
	println(revive(func() { v1.CompleteClaim(cross(cur), 2, emitter, seq, body) }))

	v2.Activate(cross(cur), wire(""))
	println(v2.Allowlisted(2, usdc))
	println(revive(func() { v2.CompleteClaim(cross(cur), 2, emitter, seq, body) }))
	println(revive(func() { v1.CompleteClaim(cross(cur), 2, emitter, sequence(usdcClaim), usdcClaim[bodyStart:]) }))

	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole_test/pauser"))
	tokenbridge.Pause(cross(cur))
	as(user)
	println(revive(func() { v2.CompleteClaim(cross(cur), 2, emitter, sequence(usdcClaim), usdcClaim[bodyStart:]) }))
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole_test/unpauser"))
	tokenbridge.Unpause(cross(cur))
	as(user)
	v2.CompleteClaim(cross(cur), 2, emitter, sequence(usdcClaim), usdcClaim[bodyStart:])
	println(tokenbridge.BalanceOf("USDC", user), tokenbridge.BalanceOf("USDC", relayer), tokenbridge.TotalSupply("USDC"))
	println(v2.Limits(65535, gnot))
}

// Output:
// 900 0 4100
// tokenbridge: claim-not-released
// 900 0 4100
// tokenbridge: claim-body-mismatch
// tokenbridge: claim-not-found
// tokenbridge: claim-wrong-type
// 1090 10 3900
// true 100 150 0 1000 900
// tokenbridge: claim-completed
// false
// tokenbridge: claim-completed
// tokenbridge: not-current-logic
// tokenbridge: bridge-paused
// 1500 0 1500
// true 100 150 0 1000 0
