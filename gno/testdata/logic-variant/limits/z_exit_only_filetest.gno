// PKGPATH: gno.land/r/wormhole_test/exitonly
package exitonly

// A logic switch moves USDC to exit-only. Under v2,
// which lists it so, USDC comes in no more: its transfer fails with
// not-allowlisted, recording nothing and leaving the replay key free, and its
// AssetMeta fails with not-allowlisted before the vault could refuse the
// repeat. Its holders still send it out, under its outbound caps of 100 per
// transfer and 150 in 24 hours: 100 and 50 go out, and 101, then 1 more in the
// same 24 hours, fail with outbound-cap, burning nothing. The reads and Render
// say exit-only. A switch to v3, which opens USDC again, redeems the same VAA.

import (
	"chain"
	"encoding/hex"
	"strings"
	"testing"
	"time"

	tb "gno.land/p/wormhole/tokenbridge/v0"
	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
	v2 "gno.land/r/wormhole/tokenbridge/logic/v2"
	v3 "gno.land/r/wormhole/tokenbridge/logic/v3"
)

const (
	peer = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
	usdc = "000000000000000000000000a000000000000000000000000000000000000048"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[6+66*13+42 : 6+66*13+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

func main(cur realm) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(1_800_000_000, 0)
	testing.SetContext(ctx)
	// This realm holds USDC and sends it out as a realm sender would.
	self := chain.PackageAddress("gno.land/r/wormhole_test/exitonly")
	recipient := [32]byte{31: 0xee}
	tokenbridge.RegisterChain(cross(cur), wire(""))
	v1.CreateWrapped(cross(cur), wire(""))
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole/tokenbridge/logic/v1"))
	tokenbridge.Mint(cross(cur), tb.Origin{Chain: 2, Address: [32]byte{12: 0xa0, 31: 0x48}}, self, 1000)
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole_test/realmcaller"))
	v2.Activate(cross(cur), wire(""))
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole_test/exitonly"))

	println(v2.Allowlisted(2, usdc), v2.ExitOnly(2, usdc))
	println(v2.Limits(2, usdc))
	inflow := wire("")
	println(revive(func() { v2.Redeem(cross(cur), inflow) }), tokenbridge.IsRedeemed(2, peer, sequence(inflow)))
	println(revive(func() {
		v2.CreateWrapped(cross(cur), wire(""))
	}))

	println(v2.TransferWrapped(cross(cur), "USDC", 100, 2, recipient, 0, 0))
	println(revive(func() { v2.TransferWrapped(cross(cur), "USDC", 101, 2, recipient, 0, 0) }))
	println(v2.TransferWrapped(cross(cur), "USDC", 50, 2, recipient, 0, 0))
	println(revive(func() { v2.TransferWrapped(cross(cur), "USDC", 1, 2, recipient, 0, 0) }))
	_, _, _, out, _, _ := v2.Limits(2, usdc)
	println(out, tokenbridge.BalanceOf("USDC", self), tokenbridge.TotalSupply("USDC"))
	for _, line := range strings.Split(v2.Render(""), "\n") {
		if strings.HasPrefix(line, "| 2:") {
			println(line)
		}
	}

	v3.Activate(cross(cur), wire(""))
	println(v3.Allowlisted(2, usdc), v3.ExitOnly(2, usdc))
	v3.Redeem(cross(cur), inflow)
	println(tokenbridge.IsRedeemed(2, peer, sequence(inflow)), tokenbridge.TotalSupply("USDC"))
}

// Output:
// false true
// true 100 150 0 1000 0
// tokenbridge: not-allowlisted false
// tokenbridge: not-allowlisted
// 0
// tokenbridge: outbound-cap
// 1
// tokenbridge: outbound-cap
// 150 850 850
// | 2:000000000000000000000000a000000000000000000000000000000000000048 | exit-only | 100 | 150 / 150 | 0 / 1000 |
// true false
// true 851
