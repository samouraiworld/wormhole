// PKGPATH: gno.land/r/wormhole_test/gnotpayloadcap
package gnotpayloadcap

// Under GNOT's per-transfer cap of 100, a direct user's TransferGNOTWithPayload of
// 101 fails with outbound-cap.

import (
	"chain"
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func main(cur realm) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(1_800_000_000, 0)
	testing.SetContext(ctx)
	user := chain.PackageAddress("gno.land/r/wormhole_test/user")
	tokenbridge.RegisterChain(cross(cur), wire(""))
	testing.SetRealm(testing.NewUserRealm(user))
	sent := chain.NewCoins(chain.NewCoin("ugnot", 101))
	testing.SetOriginSend(sent)
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge/logic/v1"), sent)
	v1.TransferGNOTWithPayload(cross(cur), 101, 2, [32]byte{31: 0xee}, nil, 0)
}

// Error:
// tokenbridge: outbound-cap
