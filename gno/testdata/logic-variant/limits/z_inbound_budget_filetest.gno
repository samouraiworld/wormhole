// PKGPATH: gno.land/r/wormhole_test/inboundbudget
package inboundbudget

// The inbound budget, under GNOT's and USDC's budget of 1,000. With
// 900 of GNOT counted, a transfer of 200 is recorded as a claim released 24
// hours later, delayed and not counted: nothing moves and the window still holds
// 900. A transfer of 100 then fits exactly and is paid at once, and one more
// unit is delayed. USDC's window is its own. A transfer of an asset this logic
// does not open, exit-only under v2, fails with not-allowlisted, over budget or
// not, with no claim and its replay key free. After a switch to a logic that
// opens it, the same VAA redeems, here delayed under the new logic's own window.

import (
	"chain"
	"chain/banker"
	"encoding/hex"
	"testing"
	"time"

	tb "gno.land/p/wormhole/tokenbridge/v0"
	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
	v2 "gno.land/r/wormhole/tokenbridge/logic/v2"
	v3 "gno.land/r/wormhole/tokenbridge/logic/v3"
)

const (
	start = 1_800_000_000
	peer  = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
	usdc  = "000000000000000000000000a000000000000000000000000000000000000048"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[6+66*13+42 : 6+66*13+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

// claim prints a transfer's redeemed flag and its claim's asset, amount, fee,
// release time, delayed flag and state.
func claim(raw []byte) {
	found, _, _, assetChain, _, amount, fee, _, _, release, delayed, state := tokenbridge.Claim(2, peer, sequence(raw))
	println(tokenbridge.IsRedeemed(2, peer, sequence(raw)), found, assetChain, amount, fee, release, delayed, "["+state+"]")
}

func ugnot(a address) int64 {
	return banker.NewReadonlyBanker().GetCoin(a, "ugnot")
}

func main(cur realm) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(start, 0)
	testing.SetContext(ctx)
	user := chain.PackageAddress("gno.land/r/wormhole_test/user")
	token := tb.GNOTAddress()
	gnot := hex.EncodeToString(token[:])
	tokenbridge.RegisterChain(cross(cur), wire(""))
	v1.CreateWrapped(cross(cur), wire(""))
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole/tokenbridge/logic/v1"))
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge"),
		chain.NewCoins(chain.NewCoin("ugnot", 5000)))
	tokenbridge.LockAndPublish(cross(cur), user, 5000, 2, [32]byte{31: 0xee}, 0, 0)
	testing.SetRealm(testing.NewUserRealm(chain.PackageAddress("gno.land/r/wormhole_test/relayer")))

	println(v1.Limits(65535, gnot))
	v1.Redeem(cross(cur), wire(""))
	println(ugnot(user), tokenbridge.LockedGNOT())
	println(v1.Limits(65535, gnot))

	delayed := wire("")
	v1.Redeem(cross(cur), delayed)
	claim(delayed)
	println(ugnot(user), tokenbridge.LockedGNOT())
	println(v1.Limits(65535, gnot))

	v1.Redeem(cross(cur), wire(""))
	println(ugnot(user), tokenbridge.LockedGNOT())
	println(v1.Limits(65535, gnot))

	oneMore := wire("")
	v1.Redeem(cross(cur), oneMore)
	claim(oneMore)
	println(v1.Limits(65535, gnot))
	println(v1.Limits(2, usdc))

	listed := wire("")
	v2.Activate(cross(cur), wire(""))
	println(v2.Allowlisted(2, usdc))
	println(revive(func() { v2.Redeem(cross(cur), listed) }))
	claim(listed)
	println(tokenbridge.BalanceOf("USDC", user))
	v3.Activate(cross(cur), wire(""))
	println(v3.Limits(2, usdc))
	v3.Redeem(cross(cur), listed)
	claim(listed)
	println(tokenbridge.BalanceOf("USDC", user), tokenbridge.TotalSupply("USDC"))
	println(v3.Limits(2, usdc))
}

// Output:
// true 100 150 0 1000 0
// 900 4100
// true 100 150 0 1000 900
// true true 65535 200 10 1800086400 true [open]
// 900 4100
// true 100 150 0 1000 900
// 1000 4000
// true 100 150 0 1000 1000
// true true 65535 1 0 1800086400 true [open]
// true 100 150 0 1000 1000
// true 100 150 0 1000 0
// false
// tokenbridge: not-allowlisted
// false false 0 0 0 0 false []
// 0
// true 100 150 0 500 0
// true true 2 2000 0 1800086400 true [open]
// 0 0
// true 100 150 0 500 0
