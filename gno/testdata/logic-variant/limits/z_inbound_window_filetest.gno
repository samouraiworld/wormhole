// PKGPATH: gno.land/r/wormhole_test/inboundwindow
package inboundwindow

// The inbound window slides by the hour. A budget of 1,000 counted at
// hour h delays even one more unit at h + 1 and at the end of h + 24, the 24 hours
// before it still counting. An hour after that, h has left the 25 buckets, so the
// same size fits again. The window counts the amount, not the shares, so a
// transfer's relayer fee takes nothing off it.

import (
	"chain"
	"encoding/hex"
	"testing"
	"time"

	tb "gno.land/p/wormhole/tokenbridge/v0"
	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
)

const (
	start = 1_800_000_000 // the start of an hour
	hour  = 3600
	peer  = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[6+66*13+42 : 6+66*13+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

func at(unix int64) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(unix, 0)
	testing.SetContext(ctx)
}

// inbound prints what GNOT's inbound window counts.
func inbound() {
	token := tb.GNOTAddress()
	_, _, _, _, _, used := v1.Limits(65535, hex.EncodeToString(token[:]))
	println(used)
}

// delay prints a transfer's release time and whether it was delayed.
func delay(raw []byte) {
	_, _, _, _, _, _, _, _, _, release, delayed, _ := tokenbridge.Claim(2, peer, sequence(raw))
	println(release, delayed)
}

func main(cur realm) {
	at(start)
	user := chain.PackageAddress("gno.land/r/wormhole_test/user")
	tokenbridge.RegisterChain(cross(cur), wire(""))
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole/tokenbridge/logic/v1"))
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge"),
		chain.NewCoins(chain.NewCoin("ugnot", 5000)))
	tokenbridge.LockAndPublish(cross(cur), user, 5000, 2, [32]byte{31: 0xee}, 0, 0)
	testing.SetRealm(testing.NewUserRealm(chain.PackageAddress("gno.land/r/wormhole_test/relayer")))

	v1.Redeem(cross(cur), wire(""))
	inbound()

	at(start + hour)
	one := wire("")
	v1.Redeem(cross(cur), one)
	delay(one)
	inbound()

	at(start + 25*hour - 1)
	inbound()
	oneMore := wire("")
	v1.Redeem(cross(cur), oneMore)
	delay(oneMore)

	at(start + 25*hour)
	inbound()
	v1.Redeem(cross(cur), wire(""))
	inbound()
	println(tokenbridge.LockedGNOT())
}

// Output:
// 1000
// 1800090000 true
// 1000
// 1000
// 1800176399 true
// 0
// 100
// 3900
