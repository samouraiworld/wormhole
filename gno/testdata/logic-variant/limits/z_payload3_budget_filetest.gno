// PKGPATH: gno.land/r/wormhole_test/payloadbudget
package payloadbudget

// A payload 3 under the inbound budget. One within the budget
// is recorded, released now and not delayed, and counted in its asset's window,
// and its recipient completes it at once. One over the budget is delayed 24 hours
// and not counted, and until then its recipient's completion fails with
// claim-not-released. Completing either counts nothing more. A wrapped asset's
// payload 3 counts in its own window.

import (
	"chain"
	"chain/banker"
	"encoding/hex"
	"testing"
	"time"

	tb "gno.land/p/wormhole/tokenbridge/v0"
	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
	"gno.land/r/wormhole_test/tbrecipient"
)

const (
	start     = 1_800_000_000
	peer      = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
	usdc      = "000000000000000000000000a000000000000000000000000000000000000048"
	bodyStart = 6 + 66*13
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[bodyStart+42 : bodyStart+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

func at(unix int64) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(unix, 0)
	testing.SetContext(ctx)
}

// inbound prints what the windows of GNOT and USDC count.
func inbound() {
	token := tb.GNOTAddress()
	_, _, _, _, _, gnot := v1.Limits(65535, hex.EncodeToString(token[:]))
	_, _, _, _, _, wrapped := v1.Limits(2, usdc)
	println(gnot, wrapped)
}

// message is what the recipient received after payload 3's 133-byte header.
func message() string {
	return tbrecipient.Last()[133:]
}

func claim(raw []byte) {
	_, id, _, _, _, amount, fee, n, _, release, delayed, state := tokenbridge.Claim(2, peer, sequence(raw))
	println(id, amount, fee, n, release, delayed, state)
}

func main(cur realm) {
	at(start)
	emitter := wire(peer)
	recipient := chain.PackageAddress("gno.land/r/wormhole_test/tbrecipient")
	tokenbridge.RegisterChain(cross(cur), wire(""))
	v1.CreateWrapped(cross(cur), wire(""))
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole/tokenbridge/logic/v1"))
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge"),
		chain.NewCoins(chain.NewCoin("ugnot", 5000)))
	tokenbridge.LockAndPublish(cross(cur), recipient, 5000, 2, [32]byte{31: 0xee}, 0, 0)
	testing.SetRealm(testing.NewUserRealm(chain.PackageAddress("gno.land/r/wormhole_test/relayer")))

	within := wire("")
	v1.Redeem(cross(cur), within)
	claim(within)
	inbound()
	tbrecipient.Complete(cross(cur), 2, emitter, sequence(within), within[bodyStart:])
	println(banker.NewReadonlyBanker().GetCoin(recipient, "ugnot"), message())
	inbound()

	over := wire("")
	v1.Redeem(cross(cur), over)
	claim(over)
	inbound()
	at(start + 86399)
	println(revive(func() { tbrecipient.Complete(cross(cur), 2, emitter, sequence(over), over[bodyStart:]) }))
	at(start + 86400)
	tbrecipient.Complete(cross(cur), 2, emitter, sequence(over), over[bodyStart:])
	println(banker.NewReadonlyBanker().GetCoin(recipient, "ugnot"), message())
	inbound()

	wrapped := wire("")
	v1.Redeem(cross(cur), wrapped)
	claim(wrapped)
	inbound()
	tbrecipient.Complete(cross(cur), 2, emitter, sequence(wrapped), wrapped[bodyStart:])
	println(tokenbridge.BalanceOf("USDC", recipient), message())
	inbound()
}

// Output:
// 3 300 0 190 1800000000 false open
// 300 0
// 300 before
// 300 0
// 3 2000 0 188 1800086400 true open
// 300 0
// tokenbridge: claim-not-released
// 2300 late
// 300 0
// 3 70 0 191 1800086400 false open
// 300 70
// 70 wrapped
// 300 70
