// PKGPATH: gno.land/r/wormhole_test/previousset
package previousset

// Token bridge governance takes only the current guardian set's VAAs. Once
// Core has moved to set 4, RegisterChain and SetPauserAddresses VAAs that set
// 3 signed still verify, since set 3 has a day left, and both fail with
// governance-not-current-set, recording and consuming nothing.

import (
	"encoding/hex"

	"gno.land/r/wormhole/core"
	"gno.land/r/wormhole/tokenbridge"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func main(cur realm) {
	// Corpus steps: Core's upgrade from set 3 to set 4, then set 3's
	// RegisterChain and SetPauserAddresses.
	core.SubmitGovernance(cross(cur), wire(""))
	println(core.CurrentGuardianSetIndex())
	println(revive(func() {
		tokenbridge.RegisterChain(cross(cur), wire(""))
	}))
	println(revive(func() {
		tokenbridge.SetPauserAddresses(cross(cur), wire(""))
	}))
	_, _, pauser, freezer, unpauser := tokenbridge.PauseState()
	println(tokenbridge.Peer(2) == "", pauser == "", freezer == "", unpauser == "")
}

// Output:
// 4
// tokenbridge: governance-not-current-set
// tokenbridge: governance-not-current-set
// true true true true
