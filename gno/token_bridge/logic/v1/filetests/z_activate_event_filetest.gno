// PKGPATH: gno.land/r/wormhole_test/activateevent
package activateevent

// Anyone calls a deployed logic's Activate with an action-2 VAA naming it
// and the vault sees that realm as the caller: the switch's only event
// names the old logic and the new one.

import (
	"encoding/hex"

	v2 "gno.land/r/wormhole/tokenbridge/logic/v2"
)

func main(cur realm) {
	raw, err := hex.DecodeString("")
	if err != nil {
		panic(err)
	}
	v2.Activate(cross(cur), raw)
}

// Events:
// [
//   {
//     "type": "LogicSwitched",
//     "attrs": [
//       {
//         "key": "old",
//         "value": "gno.land/r/wormhole/tokenbridge/logic/v1"
//       },
//       {
//         "key": "new",
//         "value": "gno.land/r/wormhole/tokenbridge/logic/v2"
//       }
//     ],
//     "pkg_path": "gno.land/r/wormhole/tokenbridge"
//   }
// ]
