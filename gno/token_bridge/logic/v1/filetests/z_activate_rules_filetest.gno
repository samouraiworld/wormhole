// PKGPATH: gno.land/r/wormhole_test/activaterules
package activaterules

// Activate follows Upgrade's rules, through real logic
// realms. A VAA naming v2, presented by v3, fails with upgrade-wrong-realm, and
// by the current logic with upgrade-caller. While paused, v2 presents it and
// the switch lands. The consumed VAA fails with governance-replay from any
// realm but the current logic. Under the chain-ID freeze a fresh VAA fails with
// bridge-frozen, and it still switches once the chain ID is back. Each refusal
// leaves the logic where it was.

import (
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
	v2 "gno.land/r/wormhole/tokenbridge/logic/v2"
	v3 "gno.land/r/wormhole/tokenbridge/logic/v3"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func on(chainID string) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(1_800_000_000, 0)
	ctx.ChainID = chainID
	testing.SetContext(ctx)
}

func main(cur realm) {
	on("dev")
	upgradeV2, upgradeV3 := wire(""), wire("")
	tokenbridge.SetPauserAddresses(cross(cur), wire(""))
	println(revive(func() { v3.Activate(cross(cur), upgradeV2) }), tokenbridge.Logic())
	println(revive(func() { v1.Activate(cross(cur), upgradeV2) }), tokenbridge.Logic())
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole_test/pauser"))
	tokenbridge.Pause(cross(cur))
	v2.Activate(cross(cur), upgradeV2)
	println(tokenbridge.Logic())
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole_test/unpauser"))
	tokenbridge.Unpause(cross(cur))
	println(revive(func() { v3.Activate(cross(cur), upgradeV2) }), tokenbridge.Logic())
	println(revive(func() { v1.Activate(cross(cur), upgradeV2) }), tokenbridge.Logic())
	println(revive(func() { v2.Activate(cross(cur), upgradeV2) }), tokenbridge.Logic())
	on("forked")
	println(revive(func() { v3.Activate(cross(cur), upgradeV3) }), tokenbridge.Logic())
	on("dev")
	v3.Activate(cross(cur), upgradeV3)
	println(tokenbridge.Logic())
}

// Output:
// tokenbridge: upgrade-wrong-realm gno.land/r/wormhole/tokenbridge/logic/v1
// tokenbridge: upgrade-caller gno.land/r/wormhole/tokenbridge/logic/v1
// gno.land/r/wormhole/tokenbridge/logic/v2
// tokenbridge: governance-replay gno.land/r/wormhole/tokenbridge/logic/v2
// tokenbridge: governance-replay gno.land/r/wormhole/tokenbridge/logic/v2
// tokenbridge: upgrade-caller gno.land/r/wormhole/tokenbridge/logic/v2
// tokenbridge: bridge-frozen gno.land/r/wormhole/tokenbridge/logic/v2
// gno.land/r/wormhole/tokenbridge/logic/v3
