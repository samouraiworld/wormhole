// PKGPATH: gno.land/r/wormhole_test/feeunpaidattest
package feeunpaidattest

// Under Core's message fee of 5, a direct user's AttestGNOT that attaches
// nothing fails with attached-amount-mismatch: GNOT's AssetMeta pays the fee
// too. 5 ugnot donated to the logic never pay it.

import (
	"chain"
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/core"
	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func main(cur realm) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(1_800_000_000, 0)
	testing.SetContext(ctx)
	user := chain.PackageAddress("gno.land/r/wormhole_test/user")
	tokenbridge.RegisterChain(cross(cur), wire(""))
	core.SubmitGovernance(cross(cur), wire(""))
	testing.SetRealm(testing.NewUserRealm(user))
	sent := chain.NewCoins()
	testing.SetOriginSend(sent)
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge/logic/v1"), sent)
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge/logic/v1"),
		chain.NewCoins(chain.NewCoin("ugnot", 5)))
	v1.AttestGNOT(cross(cur), 0)
}

// Error:
// tokenbridge: attached-amount-mismatch
