// PKGPATH: gno.land/r/wormhole_test/inboundsplit
package inboundsplit

// The inbound window at the int64 bound with the count split between the first
// and the last of its 25 hourly buckets, under a budget of MaxInt64. With
// 2^62 counted at hour h and 2^62 - 2 at hour h + 24, MaxInt64 - 1 in all, a
// transfer of 2 is delayed with nothing minted, and a transfer of 1 is paid at
// once. An hour later h's bucket has left the window.

import (
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
)

const (
	start = 1_800_000_000 // the start of an hour
	hour  = 3600
	peer  = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
	usdc  = "000000000000000000000000a000000000000000000000000000000000000048"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[6+66*13+42 : 6+66*13+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

func at(unix int64) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(unix, 0)
	testing.SetContext(ctx)
}

// state prints what the window counts and the supply.
func state() {
	_, _, _, _, _, used := v1.Limits(2, usdc)
	println(used, tokenbridge.TotalSupply("USDC"))
}

func main(cur realm) {
	at(start)
	tokenbridge.RegisterChain(cross(cur), wire(""))
	v1.CreateWrapped(cross(cur), wire(""))
	v1.Redeem(cross(cur), wire(""))
	at(start + 24*hour)
	v1.Redeem(cross(cur), wire(""))
	state()
	two := wire("")
	v1.Redeem(cross(cur), two)
	_, _, _, _, _, amount, _, _, _, release, delayed, st := tokenbridge.Claim(2, peer, sequence(two))
	println(amount, release, delayed, st)
	state()
	v1.Redeem(cross(cur), wire(""))
	state()
	at(start + 25*hour)
	state()
}

// Output:
// 9223372036854775806 9223372036854775806
// 2 1800172800 true open
// 9223372036854775806 9223372036854775806
// 9223372036854775807 9223372036854775807
// 4611686018427387903 9223372036854775807
