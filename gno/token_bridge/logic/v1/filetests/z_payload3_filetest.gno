// PKGPATH: gno.land/r/wormhole_test/logicpayload
package logicpayload

// A payload-3 transfer at the inbound bound, end to end. A relayer redeems
// a VAA whose payload is 500,000 bytes, with no share for itself, and the claim
// waits for tbrecipient. Its operator stages the body in 65,536-byte chunks and
// commits it. Then another stager's commit fails with body-already-verified,
// any other caller's completion with not-recipient, and a body with one byte
// changed with claim-body-mismatch. tbrecipient completes with an empty body and
// receives the amount and body[51:]. Afterwards, claims recorded before and
// after a logic switch both complete through the same recipient, which never
// names a logic.

import (
	"chain"
	"chain/banker"
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
	v2 "gno.land/r/wormhole/tokenbridge/logic/v2"
	"gno.land/r/wormhole_test/tbrecipient"
)

const (
	peer      = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
	chunkSize = 65536
	// bodyStart is where a 13-signature VAA's body starts.
	bodyStart = 6 + 66*13
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[bodyStart+42 : bodyStart+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

func ugnot(a address) int64 {
	return banker.NewReadonlyBanker().GetCoin(a, "ugnot")
}

// bigVAA appends to the generated prefix its payload's last bytes.
func bigVAA() []byte {
	prefix := wire("")
	raw := make([]byte, len(prefix)+500_000-133)
	copy(raw, prefix)
	for i := len(prefix); i < len(raw); i++ {
		raw[i] = byte(i-len(prefix)) ^ 0x5a
	}
	return raw
}

func main(cur realm) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(1_800_000_000, 0)
	testing.SetContext(ctx)
	emitter := wire(peer)
	vaultAddress := chain.PackageAddress("gno.land/r/wormhole/tokenbridge")
	recipient := chain.PackageAddress("gno.land/r/wormhole_test/tbrecipient")
	operator := chain.PackageAddress("gno.land/r/wormhole_test/operator")
	griefer := chain.PackageAddress("gno.land/r/wormhole_test/griefer")
	tokenbridge.RegisterChain(cross(cur), wire(""))
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole/tokenbridge/logic/v1"))
	testing.IssueCoins(vaultAddress, chain.NewCoins(chain.NewCoin("ugnot", 1200)))
	tokenbridge.LockAndPublish(cross(cur), operator, 1200, 2, [32]byte{31: 0xee}, 0, 0)

	raw := bigVAA()
	body := raw[bodyStart:]
	seq := sequence(raw)
	testing.SetRealm(testing.NewUserRealm(chain.PackageAddress("gno.land/r/wormhole_test/relayer")))
	v1.Redeem(cross(cur), raw)
	found, id, to, _, _, amount, fee, n, _, _, delayed, state := tokenbridge.Claim(2, peer, seq)
	println(found, id, address(to) == recipient, amount, fee, n, delayed, state)

	testing.SetRealm(testing.NewUserRealm(operator))
	for i := 0; i*chunkSize < len(body); i++ {
		end := (i + 1) * chunkSize
		if end > len(body) {
			end = len(body)
		}
		tokenbridge.StageChunk(cross(cur), 2, emitter, seq, i, body[i*chunkSize:end])
	}
	println(tokenbridge.StagedChunks(2, peer, seq, operator))
	tokenbridge.CommitStaged(cross(cur), 2, emitter, seq)
	verified, committer := tokenbridge.HasVerifiedBody(2, peer, seq)
	println(verified, address(committer) == operator)

	testing.SetRealm(testing.NewUserRealm(griefer))
	println(revive(func() { tokenbridge.CommitStaged(cross(cur), 2, emitter, seq) }))
	println(revive(func() { tokenbridge.CompletePayload(cross(cur), 2, emitter, seq, nil) }))
	changed := append([]byte(nil), body...)
	changed[len(changed)-1] ^= 1
	println(revive(func() { tbrecipient.Complete(cross(cur), 2, emitter, seq, changed) }))
	println(ugnot(recipient), tokenbridge.LockedGNOT())

	tbrecipient.Complete(cross(cur), 2, emitter, seq, nil)
	println(ugnot(recipient), tokenbridge.LockedGNOT(), tbrecipient.Last() == string(body[51:]), len(tbrecipient.Last()))
	_, _, _, _, _, _, _, _, _, _, _, state = tokenbridge.Claim(2, peer, seq)
	println(state)

	before, after := wire(""), wire("")
	v1.Redeem(cross(cur), before)
	v2.Activate(cross(cur), wire(""))
	v2.Redeem(cross(cur), after)
	tbrecipient.Complete(cross(cur), 2, emitter, sequence(before), before[bodyStart:])
	println(ugnot(recipient), tokenbridge.LockedGNOT(), tbrecipient.Last() == string(before[bodyStart+51:]))
	tbrecipient.Complete(cross(cur), 2, emitter, sequence(after), after[bodyStart:])
	println(ugnot(recipient), tokenbridge.LockedGNOT(), tbrecipient.Last() == string(after[bodyStart+51:]))
	println(revive(func() { tbrecipient.Complete(cross(cur), 2, emitter, sequence(after), after[bodyStart:]) }))
}

// Output:
// true 3 true 500 0 500051 false open
// 0,1,2,3,4,5,6,7
// true true
// tokenbridge: body-already-verified
// tokenbridge: not-recipient
// tokenbridge: claim-body-mismatch
// 0 1200
// 500 700 true 500000
// completed
// 800 400 true
// 1200 0 true
// tokenbridge: claim-completed
