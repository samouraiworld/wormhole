// PKGPATH: gno.land/r/wormhole_test/paymentchecks
package paymentchecks

// Redeem runs its payment's checks before its first write, so a
// refused transfer records nothing, as revive shows. A wrapper's supply at the
// int64 maximum takes no more once the window has room for the amount
// (supply-overflow, which the corpus leaves to the realms), and a redeemer no
// bank pays is refused when a fee would pay it, which only a query can present.
// With no fee, no share goes to such a redeemer, so the transfer is paid. The
// recipient itself owes no fee, so a fee above the amount, which fails for a
// relayer, pays it the whole amount. Each refusal leaves the replay key free, so
// the same VAA still redeems once it can.

import (
	"chain"
	"chain/banker"
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
)

const (
	peer = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
	usdc = "000000000000000000000000a000000000000000000000000000000000000048"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

// sequence reads a 13-signature VAA's sequence.
func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[6+66*13+42 : 6+66*13+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

func ugnot(a address) int64 {
	return banker.NewReadonlyBanker().GetCoin(a, "ugnot")
}

// at sets the block time.
func at(unix int64) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(unix, 0)
	testing.SetContext(ctx)
}

func main(cur realm) {
	at(1_800_000_000)
	user := chain.PackageAddress("gno.land/r/wormhole_test/user")
	tokenbridge.RegisterChain(cross(cur), wire(""))
	v1.CreateWrapped(cross(cur), wire(""))
	v1.Redeem(cross(cur), wire(""))
	// The window holds the whole budget until its hour has left it.
	at(1_800_000_000 + 25*3600)
	over := wire("")
	println(revive(func() { v1.Redeem(cross(cur), over) }))
	_, _, _, _, _, used := v1.Limits(2, usdc)
	println(tokenbridge.IsRedeemed(2, peer, sequence(over)), tokenbridge.TotalSupply("USDC") == 1<<63-1,
		tokenbridge.BalanceOf("USDC", user) == 1<<63-1, used)

	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole/tokenbridge/logic/v1"))
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge"),
		chain.NewCoins(chain.NewCoin("ugnot", 101)))
	tokenbridge.LockAndPublish(cross(cur), user, 101, 2, [32]byte{31: 0xee}, 0, 0)
	withFee := wire("")
	// One redeemer is malformed, and the bank would refuse the other's checksum.
	for _, bad := range []address{"not-an-address", address(string(user)[:34] + "qqqqqq")} {
		testing.SetRealm(testing.NewUserRealm(bad))
		println(revive(func() { v1.Redeem(cross(cur), withFee) }))
		println(tokenbridge.IsRedeemed(2, peer, sequence(withFee)), tokenbridge.LockedGNOT(), ugnot(user))
	}
	v1.Redeem(cross(cur), wire(""))
	println(tokenbridge.LockedGNOT(), ugnot(user))
	relayer := chain.PackageAddress("gno.land/r/wormhole_test/relayer")
	testing.SetRealm(testing.NewUserRealm(relayer))
	v1.Redeem(cross(cur), withFee)
	println(tokenbridge.LockedGNOT(), ugnot(user), ugnot(relayer))

	// A fee above the amount fails for a relayer, and leaves the key free.
	testing.SetRealm(testing.NewCodeRealm("gno.land/r/wormhole/tokenbridge/logic/v1"))
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge"),
		chain.NewCoins(chain.NewCoin("ugnot", 5)))
	tokenbridge.LockAndPublish(cross(cur), user, 5, 2, [32]byte{31: 0xee}, 0, 0)
	feeAbove := wire("")
	testing.SetRealm(testing.NewUserRealm(relayer))
	println(revive(func() { v1.Redeem(cross(cur), feeAbove) }))
	println(tokenbridge.IsRedeemed(2, peer, sequence(feeAbove)), tokenbridge.LockedGNOT())
	testing.SetRealm(testing.NewUserRealm(user))
	v1.Redeem(cross(cur), feeAbove)
	println(tokenbridge.LockedGNOT(), ugnot(user), ugnot(relayer))
}

// Output:
// tokenbridge: supply-overflow
// false true true 0
// tokenbridge: caller-address-malformed
// false 101 0
// tokenbridge: caller-address-malformed
// false 101 0
// 100 1
// 0 91 10
// tokenbridge: fee-exceeds-amount
// false 5
// 0 96 10
