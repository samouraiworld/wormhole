// PKGPATH: gno.land/r/wormhole_test/logicswitch
package logicswitch

// A logic switch, and the old logic after it. With a peer, a wrapper, an escrow, a
// redeemed transfer and an open claim under v1, a stranger calls v2's Activate
// with the action-2 VAA naming v2. Logic() is then v2, and every one of v1's
// value calls fails at the vault with not-current-logic, so nothing it read
// leaves a mark. The escrow, the redeemed set, the peer and the claim read as
// they did before the switch, and v2 serves the same state: a new transfer
// redeems, the old one stays redeemed, and the wrapper stays created.

import (
	"chain"
	"encoding/hex"
	"testing"
	"time"

	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
	v2 "gno.land/r/wormhole/tokenbridge/logic/v2"
)

const (
	peer    = "a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
	logicV1 = "gno.land/r/wormhole/tokenbridge/logic/v1"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

// sequence reads a 13-signature VAA's sequence.
func sequence(raw []byte) uint64 {
	var seq uint64
	for _, c := range raw[6+66*13+42 : 6+66*13+50] {
		seq = seq<<8 | uint64(c)
	}
	return seq
}

// state prints everything the switch must keep.
func state(paid, claimed []byte) {
	println(tokenbridge.LockedGNOT(), tokenbridge.Peer(2) == peer, tokenbridge.TotalSupply("USDC"))
	println(tokenbridge.IsRedeemed(2, peer, sequence(paid)), tokenbridge.IsRedeemed(2, peer, sequence(claimed)))
	found, id, _, _, _, amount, _, _, _, _, delayed, st := tokenbridge.Claim(2, peer, sequence(claimed))
	println(found, id, amount, delayed, st)
}

func main(cur realm) {
	ctx := testing.GetContext()
	ctx.Time = time.Unix(1_800_000_000, 0)
	testing.SetContext(ctx)
	paid, claimed := wire(""), wire("")
	var emitter [32]byte
	copy(emitter[:], wire(peer))
	tokenbridge.RegisterChain(cross(cur), wire(""))
	v1.CreateWrapped(cross(cur), wire(""))
	testing.SetRealm(testing.NewCodeRealm(logicV1))
	testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/tokenbridge"),
		chain.NewCoins(chain.NewCoin("ugnot", 1000)))
	tokenbridge.LockAndPublish(cross(cur), chain.PackageAddress("gno.land/r/wormhole_test/user"), 1000, 2,
		[32]byte{31: 0xee}, 0, 0)
	testing.SetRealm(testing.NewUserRealm(chain.PackageAddress("gno.land/r/wormhole_test/relayer")))
	v1.Redeem(cross(cur), paid)
	v1.Redeem(cross(cur), claimed)
	state(paid, claimed)
	testing.SetRealm(testing.NewUserRealm(chain.PackageAddress("gno.land/r/wormhole_test/stranger")))
	v2.Activate(cross(cur), wire(""))
	println(tokenbridge.Logic())
	state(paid, claimed)
	println(revive(func() {
		v1.Redeem(cross(cur), wire(""))
	}))
	println(revive(func() {
		v1.Redeem(cross(cur), wire(""))
	}))
	println(revive(func() {
		v1.CreateWrapped(cross(cur), wire(""))
	}))
	println(revive(func() { v1.CompleteClaim(cross(cur), 2, emitter, sequence(claimed), nil) }))
	state(paid, claimed)
	println(tokenbridge.IsRedeemed(2, peer, sequence(wire(""))))
	println(revive(func() { v2.Redeem(cross(cur), paid) }))
	println(revive(func() { v2.Redeem(cross(cur), claimed) }))
	println(revive(func() {
		v2.CreateWrapped(cross(cur), wire(""))
	}))
	v2.Redeem(cross(cur), wire(""))
	println(tokenbridge.LockedGNOT(), tokenbridge.IsRedeemed(2, peer, sequence(wire(""))))
}

// Output:
// 900 true 0
// true true
// true 3 300 false open
// gno.land/r/wormhole/tokenbridge/logic/v2
// 900 true 0
// true true
// true 3 300 false open
// tokenbridge: not-current-logic
// tokenbridge: not-current-logic
// tokenbridge: not-current-logic
// tokenbridge: not-current-logic
// 900 true 0
// true true
// true 3 300 false open
// false
// tokenbridge: transfer-redeemed
// tokenbridge: transfer-redeemed
// tokenbridge: wrapped-exists
// 899 true
