// PKGPATH: gno.land/r/wormhole_test/logicwrapped
package logicwrapped

// Wrapping through the logic. v1 refuses an AssetMeta its allowlist does
// not hold, with nothing created, and a peer's AssetMeta for another chain's
// token as that first, before the allowlist. v2, whose allowlist holds the token,
// creates an Ethereum token with 18 decimals as decimals 8, its own symbol and
// its name with " (Wormhole)", registered in grc20reg under the vault's path and
// its symbol, and records the VAA's digest. A repeat fails with wrapped-exists,
// also after a switch to v3, and a second asset whose AssetMeta says WETH becomes
// WH1. A transfer of it mints in wire units.

import (
	"chain"
	"crypto/keccak256"
	"encoding/hex"

	"gno.land/r/nt/grc20reg/v0"
	"gno.land/r/wormhole/tokenbridge"
	v1 "gno.land/r/wormhole/tokenbridge/logic/v1"
	v2 "gno.land/r/wormhole/tokenbridge/logic/v2"
	v3 "gno.land/r/wormhole/tokenbridge/logic/v3"
)

const (
	weth  = "000000000000000000000000c000000000000000000000000000000000000002"
	weth2 = "000000000000000000000000c000000000000000000000000000000000000003"
)

func wire(s string) []byte {
	b, err := hex.DecodeString(s)
	if err != nil {
		panic(err)
	}
	return b
}

// digestOf is a 13-signature VAA's digest.
func digestOf(raw []byte) string {
	h := keccak256.Sum256(raw[6+66*13:])
	d := keccak256.Sum256(h[:])
	return hex.EncodeToString(d[:])
}

func main(cur realm) {
	meta := wire("")
	tokenbridge.RegisterChain(cross(cur), wire(""))
	tokenbridge.RegisterChain(cross(cur), wire(""))
	println(revive(func() { v1.CreateWrapped(cross(cur), meta) }), tokenbridge.WrappedSymbol(2, weth) == "")
	println(revive(func() {
		v1.CreateWrapped(cross(cur), wire(""))
	}))
	v2.Activate(cross(cur), wire(""))
	v2.CreateWrapped(cross(cur), meta)
	token := grc20reg.Get("gno.land/r/wormhole/tokenbridge.WETH")
	println(token.GetSymbol(), token.GetName(), token.GetDecimals())
	println(tokenbridge.WrappedSymbol(2, weth))
	println(tokenbridge.Origin("WETH"))
	println(tokenbridge.AssetMetaDigest("WETH") == digestOf(meta))
	println(revive(func() {
		v2.CreateWrapped(cross(cur), wire(""))
	}))
	v3.Activate(cross(cur), wire(""))
	println(revive(func() {
		v3.CreateWrapped(cross(cur), wire(""))
	}))
	v3.CreateWrapped(cross(cur), wire(""))
	println(tokenbridge.WrappedSymbol(2, weth2))
	v3.Redeem(cross(cur), wire(""))
	println(tokenbridge.BalanceOf("WETH", chain.PackageAddress("gno.land/r/wormhole_test/user")),
		tokenbridge.TotalSupply("WETH"), tokenbridge.TotalSupply("WH1"))
}

// Output:
// tokenbridge: not-allowlisted true
// tokenbridge: asset-meta-wrong-emitter
// WETH Wrapped Ether (Wormhole) 8
// WETH
// 2 000000000000000000000000c000000000000000000000000000000000000002 true
// true
// tokenbridge: wrapped-exists
// tokenbridge: wrapped-exists
// WH1
// 7 7 0
