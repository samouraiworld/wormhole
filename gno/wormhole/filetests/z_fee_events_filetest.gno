// PKGPATH: gno.land/r/wormhole_test/feegovernor
package feegovernor

// SetMessageFee emits MessageFeeSet with the fee, and TransferFees emits
// FeesTransferred with the recipient's address and the amount, in that order.
// The VAAs set the fee to 1 ugnot and pay 1 ugnot to 0x…42: scenarios
// set-message-fee and transfer-fees-exceeds-balance, step 0, of the Core test
// corpus (gno/testdata/core-vectors.json). Core first receives the ugnot it
// pays out.

import (
	"chain"
	"chain/banker"
	"encoding/hex"
	"testing"

	"gno.land/r/wormhole/core"
)

const (
	setFee = ""
	payout = ""
)

func main(cur realm) {
	for _, wire := range []string{setFee, payout} {
		raw, err := hex.DecodeString(wire)
		if err != nil {
			panic(err)
		}
		if wire == payout {
			testing.IssueCoins(chain.PackageAddress("gno.land/r/wormhole/core"), chain.Coins{{"ugnot", 1}})
		}
		core.SubmitGovernance(cross(cur), raw)
	}
	println(core.MessageFee(), banker.NewReadonlyBanker().GetCoin("g1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqzzdfrzrc", "ugnot"))
}

// Output:
// 1 1

