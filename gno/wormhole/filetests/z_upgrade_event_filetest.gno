// PKGPATH: gno.land/r/wormhole_test/governor
package governor

// A guardian-set upgrade emits GuardianSetUpgraded with the old and new
// indices. The VAA upgrades set 3 to set 4 (scenario
// governance-replay, step 0, of the Core test corpus,
// gno/testdata/core-vectors.json).

import (
	"encoding/hex"

	"gno.land/r/wormhole/core"
)

const upgrade = ""

func main(cur realm) {
	raw, err := hex.DecodeString(upgrade)
	if err != nil {
		panic(err)
	}
	core.SubmitGovernance(cross(cur), raw)
	println(core.CurrentGuardianSetIndex())
}

// Output:
// 4

// Events:
// [
//   {
//     "type": "GuardianSetUpgraded",
//     "attrs": [
//       {
//         "key": "old_index",
//         "value": "3"
//       },
//       {
//         "key": "new_index",
//         "value": "4"
//       }
//     ],
//     "pkg_path": "gno.land/r/wormhole/core"
//   }
// ]
