// PKGPATH: gno.land/r/wormhole_test/consumer
package consumer

// A consumer keeps the Payload of a VAA whose raw another realm allocated.
// Payload aliases raw, so it stays that realm's: the consumer cannot modify
// it.

import (
	"encoding/hex"

	"gno.land/p/wormhole/vaa/v0"
	"gno.land/r/wormhole_test/allocator"
)

// wire is scenario quorum-13-of-19 of the Core test corpus, and
// keys its set 3. PUBLIC TEST KEYS ONLY.
const (
	wire = ""
	keys = ""
)

var kept []byte

func verify() vaa.VAA {
	b, _ := hex.DecodeString(wire)
	k, _ := hex.DecodeString(keys)
	v, err := vaa.Verify(allocator.Copy(b), string(k), 500_000)
	if err != nil {
		panic(err)
	}
	return v
}

func main() {
	kept = verify().Payload
	kept[0] = 'X'
}

